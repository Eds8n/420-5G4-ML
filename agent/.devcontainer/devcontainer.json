// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/cpp
{
	"name": "C++",
	"build": {
		"dockerfile": "Dockerfile"
	},
	
// Monter le socket X11 hote + le cookie d'authentification dans le conteneur
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=${localEnv:HOME}/.Xauthority,target=/tmp/.Xauthority,type=bind"
  ],
  
  // Transmettre l'affichage et le cookie X11
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/tmp/.Xauthority"
  },
  
  // Donner l'accès au serveur X11 (si nécessaire sur certains systèmes)
  "runArgs": [
    "--net=host"
  ],

}
